diff --git a/internal/fusefrontend/file.go b/internal/fusefrontend/file.go
index afee158..4dc5997 100644
--- a/internal/fusefrontend/file.go
+++ b/internal/fusefrontend/file.go
@@ -443,6 +443,17 @@ func (f *File) Getattr(ctx context.Context, a *fuse.AttrOut) syscall.Errno {
 	if f.rootNode.args.ForceOwner != nil {
 		a.Owner = *f.rootNode.args.ForceOwner
 	}
+	// Single-tenant mode: present the virtualized identity (after the size
+	// translation, which keys off the real regular-file type)
+	if f.rootNode.args.SingleTenant {
+		rn := f.rootNode
+		if v := rn.virtFor(f.qIno, func() *virtStat { return rn.loadVirtFd(f.intFd()) }); v != nil {
+			a.Mode = v.Mode
+			a.Owner.Uid = v.Uid
+			a.Owner.Gid = v.Gid
+			a.Rdev = v.Rdev
+		}
+	}
 
 	return 0
 }
