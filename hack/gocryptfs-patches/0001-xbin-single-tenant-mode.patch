new file mode 100644
index 0000000..fb12cbd
--- /dev/null
+++ b/internal/fusefrontend/virtnode.go
@@ -0,0 +1,314 @@
+package fusefrontend
+
+// xbin single-tenant mode (-xbin-single-tenant)
+//
+// A single-tenant mount serves exactly one security domain (for example one
+// container host's layer store), so in-mount permission enforcement protects
+// nothing: whoever can reach the mountpoint owns all of it. What DOES matter
+// is that ownership/mode/special-file metadata written by the tenant
+// round-trips exactly — container image layers carry files owned by arbitrary
+// sub-uids, 0555 directories, device nodes and whiteouts, and an unprivileged
+// gocryptfs daemon cannot (and must not) mirror any of that onto the cipher
+// tree it owns.
+//
+// This mode therefore virtualizes the identity plane:
+//
+//   - uid/gid/mode/rdev live in an encrypted xattr (stXattrName) on the
+//     cipher object; chown/chmod/mknod always succeed and the stored values
+//     are merged over the real stat on the way out;
+//   - the cipher tree stays uniformly daemon-owned — 0700 directories and
+//     0600 files — so the daemon's own I/O can never hit EACCES/EPERM;
+//   - device nodes, FIFOs, sockets and whiteouts are empty regular cipher
+//     files whose virtual type+rdev live in the xattr (the kernel serves
+//     their I/O itself, FUSE never sees an OPEN for them);
+//   - permission checks inside the mount are skipped (Access always
+//     succeeds, no default_permissions): reaching the mountpoint IS the
+//     access decision;
+//   - -allow_other is implied so the tenant's sub-uid processes are not
+//     kernel-refused.
+//
+// Known fidelity gap: Linux forbids user.* xattrs on symlinks, so symlink
+// ownership is not virtualized — lchown on a symlink is accepted as a no-op
+// and symlinks appear daemon-owned.
+//
+// On-disk compatibility: no config feature flag. The xattr is an overlay —
+// mounting a single-tenant tree without the flag (or vice versa) simply
+// ignores/lacks the virtual identities and falls back to real attributes.
+
+import (
+	"encoding/json"
+	"fmt"
+	"sync"
+	"sync/atomic"
+	"syscall"
+
+	"golang.org/x/sys/unix"
+
+	"github.com/hanwen/go-fuse/v2/fs"
+	"github.com/hanwen/go-fuse/v2/fuse"
+
+	"github.com/rfjakob/gocryptfs/v2/internal/inomap"
+	"github.com/rfjakob/gocryptfs/v2/internal/nametransform"
+	"github.com/rfjakob/gocryptfs/v2/internal/syscallcompat"
+	"github.com/rfjakob/gocryptfs/v2/internal/tlog"
+)
+
+// In-memory caches for the identity plane. These are sound ONLY because a
+// single-tenant mount's daemon is the sole writer of its cipher tree — no
+// other process can change the xattrs behind its back. They matter because
+// the kernel stats constantly and asks for security.capability before EVERY
+// write (https://github.com/rfjakob/gocryptfs/issues/515); without caching,
+// small-file workloads (npm, image builds) pay an encrypted-xattr round
+// trip per operation. Keyed per inode (hard links share identity by
+// design); a crude size cap bounds memory on huge trees.
+const virtCacheMax = 1 << 19
+
+type virtMemCache struct {
+	m sync.Map
+	n atomic.Int64
+}
+
+func (c *virtMemCache) get(k any) (any, bool) { return c.m.Load(k) }
+
+func (c *virtMemCache) put(k, v any) {
+	if _, loaded := c.m.Swap(k, v); !loaded && c.n.Add(1) > virtCacheMax {
+		c.m.Clear()
+		c.n.Store(0)
+	}
+}
+
+// virtFor returns the (possibly cached) identity for an inode, calling load
+// on a miss and remembering the result — including "no identity" (nil).
+func (rn *RootNode) virtFor(qi inomap.QIno, load func() *virtStat) *virtStat {
+	if v, ok := rn.virtIdCache.get(qi); ok {
+		vs, _ := v.(*virtStat)
+		return vs
+	}
+	vs := load()
+	rn.virtIdCache.put(qi, vs)
+	return vs
+}
+
+// rememberVirt records a just-written identity (st only provides the inode
+// key and must be the raw, untranslated stat).
+func (rn *RootNode) rememberVirt(st *syscall.Stat_t, v *virtStat) {
+	rn.virtIdCache.put(inomap.QInoFromStat(st), v)
+}
+
+// stXattrName is the cipher-side xattr holding the virtualized stat data.
+// The dotted suffix cannot collide with encrypted xattr names
+// ("user.gocryptfs." + base64url, which never contains a dot). The value is
+// encrypted with the regular xattr-value machinery, so the identity plane is
+// as opaque at rest as file contents. Hidden from Listxattr.
+const stXattrName = "user.gocryptfs.xbin.stat"
+
+// virtStat is the virtualized identity of one file: what the tenant chowned/
+// chmodded/mknoded, merged over the real stat on the way out. Mode carries
+// the full st_mode (type bits + permissions).
+type virtStat struct {
+	Uid  uint32 `json:"u"`
+	Gid  uint32 `json:"g"`
+	Mode uint32 `json:"m"`
+	Rdev uint32 `json:"r,omitempty"`
+}
+
+// virtFromStat seeds a virtual identity from the real stat — used the first
+// time a file that predates single-tenant mode is chowned/chmodded.
+func virtFromStat(st *syscall.Stat_t) *virtStat {
+	return &virtStat{Uid: st.Uid, Gid: st.Gid, Mode: st.Mode, Rdev: uint32(st.Rdev)}
+}
+
+// applyVirt merges the stored virtual identity (if any) over the real stat.
+// Size, times, nlink and inode identity stay real.
+func applyVirt(st *syscall.Stat_t, v *virtStat) {
+	if v == nil {
+		return
+	}
+	st.Uid = v.Uid
+	st.Gid = v.Gid
+	st.Mode = v.Mode
+	st.Rdev = uint64(v.Rdev)
+}
+
+// decodeVirt decrypts and parses a stored identity. Unreadable/corrupt data
+// degrades to nil (real attributes) rather than erroring the whole stat.
+func (rn *RootNode) decodeVirt(cData []byte) *virtStat {
+	data, err := rn.decryptXattrValue(cData)
+	if err != nil {
+		tlog.Warn.Printf("single-tenant: undecryptable %s value: %v", stXattrName, err)
+		return nil
+	}
+	var v virtStat
+	if err := json.Unmarshal(data, &v); err != nil {
+		tlog.Warn.Printf("single-tenant: malformed %s value: %v", stXattrName, err)
+		return nil
+	}
+	return &v
+}
+
+func (rn *RootNode) encodeVirt(v *virtStat) []byte {
+	data, err := json.Marshal(v)
+	if err != nil {
+		// cannot happen for a struct of integers
+		tlog.Warn.Printf("single-tenant: marshal: %v", err)
+		return nil
+	}
+	return rn.encryptXattrValue(data)
+}
+
+// loadVirtAt reads the virtual identity of dirfd/cName; nil when absent.
+// Symlinks can't carry user.* xattrs, so they always return nil here.
+func (rn *RootNode) loadVirtAt(dirfd int, cName string) *virtStat {
+	procPath := fmt.Sprintf("/proc/self/fd/%d/%s", dirfd, cName)
+	cData, err := syscallcompat.Lgetxattr(procPath, stXattrName)
+	if err != nil {
+		return nil
+	}
+	return rn.decodeVirt(cData)
+}
+
+func (rn *RootNode) loadVirtFd(fd int) *virtStat {
+	cData, err := syscallcompat.Fgetxattr(fd, stXattrName)
+	if err != nil {
+		return nil
+	}
+	return rn.decodeVirt(cData)
+}
+
+func (rn *RootNode) saveVirtAt(dirfd int, cName string, v *virtStat) error {
+	procPath := fmt.Sprintf("/proc/self/fd/%d/%s", dirfd, cName)
+	return unix.Lsetxattr(procPath, stXattrName, rn.encodeVirt(v), 0)
+}
+
+func (rn *RootNode) saveVirtFd(fd int, v *virtStat) error {
+	return unix.Fsetxattr(fd, stXattrName, rn.encodeVirt(v), 0)
+}
+
+// virtOverlayAt merges the stored identity into st. No-op unless mounted
+// -xbin-single-tenant. Call after every Fstatat on a cipher path whose result
+// reaches the kernel.
+func (n *Node) virtOverlayAt(dirfd int, cName string, st *syscall.Stat_t) {
+	rn := n.rootNode()
+	if !rn.args.SingleTenant {
+		return
+	}
+	qi := inomap.QInoFromStat(st)
+	applyVirt(st, rn.virtFor(qi, func() *virtStat { return rn.loadVirtAt(dirfd, cName) }))
+}
+
+// newVirt builds the identity for a freshly created object: the mode the
+// tenant asked for (with the type normalized by the caller) owned by the
+// calling process. caller may be nil (owner stays 0:0 — does not happen for
+// real FUSE requests, which always carry a Caller).
+func newVirt(caller *fuse.Context, mode, rdev uint32) *virtStat {
+	v := &virtStat{Mode: mode, Rdev: rdev}
+	if caller != nil {
+		v.Uid = caller.Uid
+		v.Gid = caller.Gid
+	}
+	return v
+}
+
+// applySetattrVirt folds the chmod/chown parts of a SETATTR into the stored
+// identity (seeded from the real stat when there is none yet). Returns nil
+// when the request carries no mode/uid/gid change.
+func applySetattrVirt(in *fuse.SetAttrIn, cur *virtStat, st *syscall.Stat_t) *virtStat {
+	mode, mOk := in.GetMode()
+	uid, uOk := in.GetUID()
+	gid, gOk := in.GetGID()
+	if !mOk && !uOk && !gOk {
+		return nil
+	}
+	v := cur
+	if v == nil {
+		v = virtFromStat(st)
+	}
+	if mOk {
+		// chmod never changes the file type
+		v.Mode = v.Mode&syscall.S_IFMT | mode&^syscall.S_IFMT
+	}
+	if uOk {
+		v.Uid = uid
+	}
+	if gOk {
+		v.Gid = gid
+	}
+	return v
+}
+
+// setattrVirtAt virtualizes the chmod/chown parts of a path-based SETATTR:
+// the stored identity is updated, the cipher object is never touched.
+// Symlink chown is accepted as a no-op (documented fidelity gap).
+func (n *Node) setattrVirtAt(dirfd int, cName string, in *fuse.SetAttrIn) syscall.Errno {
+	rn := n.rootNode()
+	st, err := syscallcompat.Fstatat2(dirfd, cName, unix.AT_SYMLINK_NOFOLLOW)
+	if err != nil {
+		return fs.ToErrno(err)
+	}
+	if st.Mode&syscall.S_IFMT == syscall.S_IFLNK {
+		return 0
+	}
+	qi := inomap.QInoFromStat(st)
+	cur := rn.virtFor(qi, func() *virtStat { return rn.loadVirtAt(dirfd, cName) })
+	v := applySetattrVirt(in, cur, st)
+	if v == nil {
+		return 0
+	}
+	if errno := fs.ToErrno(rn.saveVirtAt(dirfd, cName, v)); errno != 0 {
+		return errno
+	}
+	rn.rememberVirt(st, v)
+	return 0
+}
+
+// setattrVirtFd is setattrVirtAt for an open file handle.
+func setattrVirtFd(rn *RootNode, fd int, in *fuse.SetAttrIn) syscall.Errno {
+	var st syscall.Stat_t
+	if err := syscall.Fstat(fd, &st); err != nil {
+		return fs.ToErrno(err)
+	}
+	qi := inomap.QInoFromStat(&st)
+	cur := rn.virtFor(qi, func() *virtStat { return rn.loadVirtFd(fd) })
+	v := applySetattrVirt(in, cur, &st)
+	if v == nil {
+		return 0
+	}
+	if errno := fs.ToErrno(rn.saveVirtFd(fd, v)); errno != 0 {
+		return errno
+	}
+	rn.rememberVirt(&st, v)
+	return 0
+}
+
+// createVirtSpecialAt creates the cipher-side representation of a special
+// file (device node, FIFO, socket, overlay whiteout): an empty regular
+// cipher file plus the virtual identity. Long-name bookkeeping mirrors
+// Mknod; an already-existing .name file (whiteout landing on a name that
+// just had its file renamed away) is fine.
+func (n *Node) createVirtSpecialAt(caller *fuse.Context, dirfd int, cName, name string, mode, rdev uint32) error {
+	rn := n.rootNode()
+	if !rn.args.PlaintextNames && nametransform.IsLongContent(cName) {
+		err := rn.nameTransform.WriteLongNameAt(dirfd, cName, name)
+		if err != nil && err != syscall.EEXIST {
+			return err
+		}
+	}
+	fd, err := syscallcompat.Openat(dirfd, cName,
+		syscall.O_WRONLY|syscall.O_CREAT|syscall.O_EXCL|syscall.O_NOFOLLOW, 0600)
+	if err != nil {
+		return err
+	}
+	defer syscall.Close(fd)
+	if mode&syscall.S_IFMT == 0 {
+		mode |= syscall.S_IFREG
+	}
+	v := newVirt(caller, mode, rdev)
+	if err := rn.saveVirtFd(fd, v); err != nil {
+		return err
+	}
+	var st syscall.Stat_t
+	if err := syscall.Fstat(fd, &st); err == nil {
+		rn.rememberVirt(&st, v)
+	}
+	return nil
+}
