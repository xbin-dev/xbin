{
  // The journey passes' MCP tile (hack/ui-harness/passes/journey*.js): the
  // smallest thing an agent's `mcp` slot can bind — one tool, roll_dice,
  // served as streamable HTTP at /mcp. This is the "prepared tile source"
  // the scripted coding agent copies into place; a real coding agent would
  // write these four files.
  "title": "Dice",
  "runtime": "node",
  "expose": { "roles": { "reader": "Call the dice tools (MCP at /mcp)" } },
  "provides": { "mcp": { "kind": "http", "service": "mcp", "role": "reader" } }
}
