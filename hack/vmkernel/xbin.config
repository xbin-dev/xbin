# xbin VM-sandbox guest kernel: options on top of Firecracker's CI guest
# config (hack/build-vmkernel.sh merges this fragment, then verifies every
# line below survived olddefconfig — a dropped dependency fails the build).
#
# The guest root is a read-only erofs image of the xbin rootfs.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_ZIP=y
# Tile dir, homes and resources come in as FUSE filesystems (the agent pumps
# /dev/fuse over vsock to the host shim's server).
CONFIG_FUSE_FS=y
# The persistent VM disk (overlay upper) and templates.
CONFIG_EXT4_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_VSOCKETS=y
# Memory: virtio-mem sizing after template restore, free page reporting.
CONFIG_VIRTIO_MEM=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_PAGE_REPORTING=y
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y
# Snapshot uniqueness: the RNG reseeds on restore.
CONFIG_VMGENID=y
# Containers inside the VM (docker/podman): namespaces, cgroups, netfilter.
CONFIG_USER_NS=y
CONFIG_CGROUP_BPF=y
CONFIG_MEMCG=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_TUN=y
CONFIG_NF_TABLES=y
CONFIG_NFT_COMPAT=y
CONFIG_IP_NF_NAT=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
