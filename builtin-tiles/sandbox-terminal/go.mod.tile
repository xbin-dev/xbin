module sandbox-terminal

go 1.26.0

require (
	github.com/xbin-dev/xbin/sdk v0.0.0
	golang.org/x/crypto v0.57.0
)

require golang.org/x/sys v0.48.0 // indirect

// xbin/sdk is resolved by the workspace go.work (generated by xbind).
// x/crypto (the SSH server) stays at a release with no known vulnerability
// this tile's code reaches. Since v0.56.0 it needs go 1.26.0: the Go xbind's
// installer puts on the host builds the tile, the base rootfs's Go builds it
// in terminals, and the workspace go.work's go line follows its modules'.
