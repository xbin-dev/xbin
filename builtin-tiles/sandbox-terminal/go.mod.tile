module sandbox-terminal

go 1.24

require (
	github.com/xbin-dev/xbin/sdk v0.0.0
	golang.org/x/crypto v0.48.0
)

require golang.org/x/sys v0.41.0 // indirect

// xbin/sdk is resolved by the workspace go.work (generated by xbind).
// `go 1.24`, not 1.24.0: xbind's go.work says `go 1.24`, and a module it uses
// with a later go line fails the build. x/crypto (the SSH server) is pinned
// to the newest release whose go directive (1.24.0) the rootfs toolchain
// (Go 1.24.0, docker/rootfs.Dockerfile) meets.
