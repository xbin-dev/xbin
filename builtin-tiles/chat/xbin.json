{
  // LLM chat tile — pure frontend. It requests an "openai" http interface
  // (plans/interfaces.md) rather than hard-coding a provider; the owner binds
  // it to one OR MORE OpenAI-compatible provider tiles ("multi": true — the
  // admin Interfaces tab shows a multiselect). The binding is also the call
  // grant, so no separate `uses` is needed. The frontend discovers every bound
  // endpoint via xbin.iface('llm').endpoints and lists models from all of them.
  "interfaces": {
    "llm": { "kind": "http", "service": "openai", "multi": true }
  }
}
