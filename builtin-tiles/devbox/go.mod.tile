module devbox

go 1.24

require (
	github.com/creack/pty v1.1.24
	github.com/xbin-dev/xbin/sdk v0.0.0
	golang.org/x/crypto v0.36.0
)

// The sdk is resolved by the workspace go.work (generated by xbind); the
// external deps (x/crypto for the SSH server, creack/pty for the shell PTY)
// are fetched on first build.
