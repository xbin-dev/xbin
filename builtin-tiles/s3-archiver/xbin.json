{
  // S3 archiver — an `archive` interface provider (plans/lifecycle.md). Bind a
  // component's `@archive` to this tile (or set it as the workspace default:
  // `bx bind '*' @archive=apps/s3-archiver`) and xbind streams that component's
  // backups here to be stored in S3. Powers manual backup, scheduled backup, and
  // offload. Endpoint/region/bucket/prefix are configured on this tile's page;
  // the access key + secret live in its vault (never in a resource).
  "runtime": "go",
  "uses": [
    { "target": "res:apps/s3-archiver/state", "role": "writer" }
  ],
  // This tile reaches the S3 endpoint over the network, so it needs egress — a
  // `net` interface the owner binds (plans/interfaces.md). Under isolation it has
  // ZERO egress until bound: `bx bind apps/s3-archiver net=internet` for a public
  // bucket (AWS/R2/B2), or bind it to a `lan:<cidr>` / a provider tile to reach a
  // LAN MinIO or route through a VPN/proxy. Backups fail with "dial tcp … refused"
  // if this is left unbound.
  "interfaces": {
    "net": { "kind": "net" }
  },
  // Offer the archive interface. The owner binds components' @archive to it; only
  // the owner (xbind) calls the /archive endpoints, so no exposed role is needed.
  "provides": {
    "store": { "kind": "archive", "service": "s3" }
  }
}
