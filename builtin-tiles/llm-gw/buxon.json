{
  // OpenAI-compatible LLM gateway. Other tiles get a reader/writer grant to
  // call the proxied /v1/* API; base URL + model aliases are configured on
  // this tile's own frontend (self is always admin of itself, see
  // docs/auth.md — that's how the settings panel talks to /config and to
  // this component's own vault key without any extra grant).
  "runtime": "go",
  "uses": [
    { "target": "res:apps/llm-gw/state", "role": "writer" },
    // Reaches the configured upstream provider (OpenAI, OpenRouter, …). Under
    // isolation (buxond --isolate) a backend has NO network egress until granted;
    // this is the owner-approved grant that lets llm-gw call out. net:internet is
    // public providers only — for a LAN/self-hosted endpoint (Ollama, vLLM on
    // your network) add e.g. { "target": "net:192.168.1.5:11434", "role": "egress" }.
    { "target": "net:internet", "role": "egress" }
  ],
  "expose": {
    "roles": {
      "reader": "List available models (real + aliases) via GET /v1/models",
      "writer": "Call the OpenAI-compatible API — chat/completions, embeddings, etc. (implies reader)"
    }
  },
  // Offer an "openai" http interface (plans/interfaces.md): any tile can request
  // an { kind: http, service: "openai" } interface and the owner binds it here —
  // the binding grants the caller the "writer" role, so providers are swappable
  // without the caller hard-coding this path.
  "provides": {
    "openai": { "kind": "http", "service": "openai", "role": "writer" }
  }
}
