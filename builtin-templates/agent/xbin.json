{
  // A TEMPLATE component (docs/overview/03-components.md §Templates; API.md): a blank-slate
  // agentic loop. Instantiate it into a named copy (Tile Manager → "New from
  // template", or `bx template new agent as apps/my-agent`) and build it up
  // into a practical agent that moves data around xbin between components.
  // The "template" block is stripped from each instance.
  "template": {
    "title": "AI Agent",
    "description": "A durable, debuggable agentic loop — sqlite-persisted, event-driven, LLM via any bound provider (llm-gw) with streamed thinking, tools + subagents (shown inline) + MCP, steering mid-turn, compaction, self-scheduling. Clone it and build up.",
    "defaultName": "agent",
    // New instances keep each person's conversations apart: one backend per
    // person plus a global instance (docs/partitions.md, API.md "Partitioned
    // instances"). Instantiating writes this as the copy's own "partition";
    // untick "Keep each person's data apart" (or --no-partition) for one
    // unpartitioned instance, which is also what xbind without --isolate
    // makes. And every existing instance asks for it too once it merges
    // this template's update (`git merge template/main`; partitionOnUpdate,
    // D177): one holding data pauses until a manager switches it — which
    // deletes its data — or keeps its current mode; an empty one switches.
    // Under --isolate only.
    "partition": ["user", "global"],
    "partitionOnUpdate": true
  },

  // Where xbind rings the partition-mail doorbell (a partitioned instance
  // only), and what a mode switch of an instance that holds data deletes.
  "partitionMail": "/mailbox",
  "partitionNote": "Every conversation (private and shared), all memory and every schedule of this agent are deleted, for everyone, with its skills, triggers, channel links and settings. Sandboxes stay with their sandbox manager.",

  "runtime": "go",
  // The backend lives in _backend/ (not the usual backend/): the underscore
  // keeps xbin's own `go build ./...` from sweeping this template payload —
  // which pulls modernc.org/sqlite — into the xbin module. Go's wildcard
  // skips _-prefixed dirs; an explicit `go build ./_backend` still compiles it,
  // and `all:`-embed still bundles it. Instances build fine.
  "entry": "./_backend",

  // This agent's own resources — same-scope and auto-granted. (The LLM is
  // the `llm` interface below, not a grant by name.) As you teach the agent
  // to call other components, add their grants here — the agent can never
  // self-approve cross-scope access (docs/auth.md, AGENTS.md).
  "uses": [
    { "target": "res:apps/agent/db", "role": "writer" },
    { "target": "res:apps/agent/beat", "role": "writer" },
    { "target": "res:apps/agent/events", "role": "writer" },
    { "target": "res:apps/agent/files", "role": "writer" },
    // A partitioned instance's shared ground (scope.json): conf, the
    // tile-wide settings the global instance mirrors for people's partitions
    // to read; team, the one database every partition shares, beside which
    // the tile-wide cap on model calls keeps its locks. An unpartitioned
    // instance never opens them.
    { "target": "res:apps/agent/conf", "role": "writer" },
    { "target": "res:apps/agent/team", "role": "writer" },
    // The chat renders markdown links with target="_blank"; a sandboxed
    // frame may only open new tabs with cap:open-links (ND11). Lands
    // pending — approve it in the grants panel.
    { "target": "cap:open-links", "role": "writer" }
  ],

  // MCP servers are bound like the chat tile: a multi:true `mcp` http slot
  // (service "mcp"). The owner binds zero or more MCP-providing components in
  // the Interfaces tab; their tools are offered to the model and calls route
  // back through the binding (which is also the grant). A bound provider
  // exposes the Streamable-HTTP endpoint at "/mcp" under itself. (Legacy: a
  // static config.mcp list of external servers still works too.)
  "interfaces": {
    // The models (D111): one or more OpenAI-compatible providers — llm-gw, or
    // any tile that provides service "openai" — bound like the chat tile's.
    // Their models are offered in the chat's picker, grouped by provider;
    // the binding is the grant. Unbound, the agent falls back to apps/llm-gw
    // by name (an older instance's grant).
    "llm": { "kind": "http", "service": "openai", "multi": true },
    "mcp": { "kind": "http", "service": "mcp", "multi": true },
    // Coding sandboxes (D115): one or more sandbox managers — the builtin
    // coding-sandbox template once it ships, or any tile that provides service
    // "sandbox-manager" (docs/sandbox-manager.md). A conversation of a class
    // with the sandbox toolset works in one of their sandboxes; the binding
    // is the grant. Unbound = no sandboxes.
    "sandboxes": { "kind": "http", "service": "sandbox-manager", "multi": true },
    // Egress for the web lane's web_search/web_fetch tools. Unbound = zero
    // egress and the tools report themselves unavailable; the owner may
    // `bx bind <this component> net=internet` (or the admin Interfaces tab).
    "net": { "kind": "net" }
  },

  // Who may call what. "admin" is the tile itself and its owner: the whole
  // API, where people are told apart inside (API.md, D83). "channel" is what
  // a bound chat adapter holds: the /adapter/* routes only
  // (docs/agent-inbox.md).
  "expose": {
    "roles": {
      "admin": "The tile and its owner: the whole API (API.md)",
      "channel": "A chat adapter bound to this agent's inbox: /adapter/* only (docs/agent-inbox.md)"
    }
  },
  // Chat channels (D86): an adapter tile (a copy of the agent-messaging-bridge
  // template, made to speak Slack, Discord, …) requests an http
  // interface with service "agent-inbox" and the owner binds it to this
  // agent; the binding grants it the channel role. A new channel then shows
  // on the Automations page for a manager to claim.
  "provides": {
    "inbox": { "kind": "http", "service": "agent-inbox", "role": "channel" }
  }
}
