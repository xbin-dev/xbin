{
  // A TEMPLATE component (docs/overview/03-components.md §Templates; API.md):
  // GitHub as an scm provider (docs/scm.md, protocol 1). Instantiate it (Tile
  // Manager → "New from template", or `bx template new scm-github`); the
  // "template" block is stripped from each copy.
  "template": {
    "title": "GitHub (scm)",
    "description": "Repos, credentials, pull requests, CI and events from GitHub for the agent and any tile that binds service scm (docs/scm.md): a GitHub App at the global instance, each person's own GitHub sign-in in their partition.",
    "defaultName": "scm-github",
    // One backend per person (their GitHub sign-in, in their partition's
    // vault) plus a global instance (the App's keys, installation tokens,
    // setup, policy and the identity directory) — docs/partitions.md. An
    // unpartitioned copy (no --isolate, or --no-partition) is bot-only.
    "partition": ["user", "global"]
  },

  // What a mode switch of a copy that holds data deletes.
  "partitionNote": "A full switch forgets every person's GitHub sign-in (they sign in again). A full switch, or removing global, deletes the App's keys and secrets, the identity directory, subscriptions and undelivered events: paste the keys again, or make a new private key in the App's settings.",

  "runtime": "go",
  // The backend lives in _backend/ (not backend/): the underscore keeps xbin's
  // own `go build ./...` from sweeping this template payload into the xbin
  // module. Instances build it from here.
  "entry": "./_backend",

  "uses": [
    // state — kv: the App's public settings, the policy, the identity
    // directory and caches at global; a person's sign-in summary in their
    // partition. Never a secret: those are in the vault (API.md §Storage).
    { "target": "res:apps/scm-github/state", "role": "writer" },
    // conf — kv the global instance writes and people's partitions read: the
    // App's public settings (client id, hosts, device flow) and the policy's
    // public half.
    { "target": "res:apps/scm-github/conf", "role": "writer" },
    // tick — cron: retries undelivered events while any are queued.
    { "target": "res:apps/scm-github/tick", "role": "writer" },
    // The page opens GitHub (the App's settings, the manifest form, the
    // device sign-in) in new tabs; a sandboxed frame may only do that with
    // cap:open-links. Lands pending — approve it in the grants panel.
    { "target": "cap:open-links", "role": "writer" }
  ],

  "interfaces": {
    // Egress to GitHub. Bind it to the internet, or narrow it — job logs are
    // a redirect to the last two hosts (API.md §Setting it up):
    //   bx bind apps/scm-github net=internet
    //   bx bind apps/scm-github net=internet:github.com,api.github.com,*.actions.githubusercontent.com,*.blob.core.windows.net
    "net": { "kind": "net" },
    // The agents events are delivered to (their /adapter/scm/event):
    //   bx bind apps/scm-github agents+=apps/agent
    "agents": { "kind": "http", "service": "agent-inbox", "multi": true }
  },

  // GitHub's webhooks and the App-manifest callback come from outside. Publish
  // them on the global instance only (a partition answers 404 on both):
  //   bx expose apps/scm-github hooks=apps/traefik --host scm.example.com
  "exposes": {
    "hooks": { "kind": "http", "paths": ["/hook/github", "/setup/github"] }
  },

  // "admin" is the tile itself, its owner and its managers: the page, setup
  // and policy. "consumer" is what a bound consumer tile holds: the scm
  // contract's /scm/* routes only.
  "expose": {
    "roles": {
      "admin": "The tile, its owner and its managers: the page, setup and policy (API.md)",
      "consumer": "Use GitHub through this tile: the scm contract's /scm/* routes (docs/scm.md)"
    }
  },

  // Consumers (the agent's `scm` slot, any tile that requests service "scm")
  // bind here; the binding grants them the consumer role:
  //   bx bind apps/agent scm+=apps/scm-github
  "provides": {
    "scm": { "kind": "http", "service": "scm", "role": "consumer" }
  }
}
