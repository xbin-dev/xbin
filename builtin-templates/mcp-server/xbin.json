{
  // A TEMPLATE component (docs/overview/03-components.md §Templates; API.md,
  // docs/mcp.md): tools for an agent. Instantiate it (Tile Manager → "New
  // from template", or `bx template new mcp-server as apps/dice`); the
  // "template" block is stripped from each copy.
  "template": {
    "title": "MCP server",
    "description": "Tools for an agent: a small Go MCP server (streamable HTTP at /mcp) with one example tool, roll_dice. Bind an agent's mcp slot to a copy and its conversations can call the tools; add a tool with one function and one line (docs/mcp.md).",
    "defaultName": "mcp-server"
  },

  "runtime": "go",

  // The backend lives in _backend/ (not backend/): the underscore keeps xbin's
  // own `go build ./...` from sweeping this template payload into the xbin
  // module. Instances build it from here.
  "entry": "./_backend",

  // What a person's workspace agent may do here for them (docs/auth.md
  // §Delegation): call the tools as that person — reads freely, and each
  // tools/call only after the person approved that call (xbind asks). The
  // example tool changes nothing. Narrow it to "read" (or "off") if a tool
  // you add hands out secrets or acts in the world (API.md §Agents).
  "agent": "full",

  // "reader" is what a bound consumer holds — an agent's `mcp` slot: POST
  // /mcp, the tools. The tile itself, its owner and its managers are admin.
  "expose": {
    "roles": {
      "reader": "Call this tile's tools: MCP at POST /mcp (API.md)"
    }
  },

  // Don't change this: it is the contract an agent's `mcp` slot binds
  // (kind http, service "mcp", the endpoint at /mcp under this tile), and
  // the binding is the consumer's grant. Declared from the first second, so
  // a binding is valid before a single tool is added:
  //   bx bind apps/assistant mcp+=<this tile>
  "provides": {
    "mcp": { "kind": "http", "service": "mcp", "role": "reader" }
  }
}
