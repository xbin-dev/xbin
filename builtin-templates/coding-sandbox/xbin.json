{
  // A TEMPLATE component (docs/overview/03-components.md §Templates; API.md): the
  // builtin SANDBOX MANAGER (docs/sandbox-manager.md, D115, D122). Instantiate it
  // (Tile Manager → "New from template", or
  // `bx template new coding-sandbox as apps/coding-sandbox`); each copy is a
  // manager with its own images, sizes and quotas. The "template" block is
  // stripped from each copy.
  "template": {
    "title": "Coding sandboxes",
    "description": "A sandbox manager: coding sandboxes — VMs by default, on xbind's own runtime — for the agent and any tile that binds it (docs/sandbox-manager.md). Images are setup scripts built once and cloned; each consumer tile sees its own sandboxes and those shared with it; per-person access and per-consumer quotas. Needs cap:sandboxes, which a workspace admin approves.",
    "defaultName": "coding-sandbox"
  },

  "runtime": "go",
  // The backend lives in _backend/ (not backend/): the underscore keeps xbin's
  // own `go build ./...` from sweeping this template payload — which pulls
  // modernc.org/sqlite — into the xbin module. Instances build it from here.
  "entry": "./_backend",

  "uses": [
    // The manager's own table: its sandboxes' ids, owners, shares, labels,
    // clientIds and built images (API.md §Storage).
    { "target": "res:apps/coding-sandbox/db", "role": "writer" },
    // xbind's tile-sandbox runtime (D120): the sandboxes themselves. It lands
    // pending; only a workspace admin approves it (docs/auth.md).
    { "target": "cap:sandboxes", "role": "writer" }
  ],

  // The networks this manager's SANDBOXES may use — never its own backend's
  // (docs/overview/11-interfaces.md §sandbox-net). An unbound class is `none`,
  // and a consumer is offered `internet` / `open` only while its class is bound:
  //   bx bind apps/coding-sandbox internet=internet
  //   bx bind apps/coding-sandbox open=lan:10.42.0.0/16     (an operator's call)
  "interfaces": {
    "internet": { "kind": "sandbox-net" },
    "open": { "kind": "sandbox-net" }
  },

  // "admin" is the tile itself, its owner and its operators (people with write
  // access): the page and /api/* (API.md). "consumer" is what a bound consumer
  // tile holds: the contract's /sbx/* routes only.
  "expose": {
    "roles": {
      "admin": "The tile, its owner and its operators: the page and /api/* (API.md)",
      "consumer": "Use this tile's sandboxes (the sandbox-manager contract, /sbx/*)"
    }
  },
  // Consumers (the agent's `sandboxes` slot, sandbox-terminal, any tile that
  // requests service "sandbox-manager") bind here; the binding grants them the
  // consumer role:  bx bind apps/agent sandboxes+=apps/coding-sandbox
  "provides": {
    "sandboxes": { "kind": "http", "service": "sandbox-manager", "role": "consumer" }
  }
}
