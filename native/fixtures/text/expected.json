    {"k":"r.0.4","t":"stack","p":{"gap":"s"},"c":[
      {"k":"r.0.4.0","t":"text","p":{"style":"title3","text":"Root cause"}},
      {"k":"r.0.4.1","t":"text","p":{"text":"A config change in v2.14.0 set the HTTP client's idle timeout to 0, so every request opened a new TLS connection to the provider."}},
      {"k":"r.0.4.2","t":"text","p":{"style":"mono","text":"2026-09-21T12:02:14Z WARN pay.client dial tcp 18.194.3.7:443: rate limited (429)"}},
