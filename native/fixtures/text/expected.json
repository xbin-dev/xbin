      {"k":"r.0.0.1","t":"text","p":{"style":"largeTitle","text":"Checkout latency above 4 s"}},
      {"k":"r.0.0.2","t":"text","p":{"style":"subheadline","tone":"accent","text":"monitoring · SEV-2 · 105 min"}}
    ]},
    {"k":"r.0.1","t":"text","p":{"style":"body","lines":2,"text":"Checkout requests in eu-central slowed to a p95 of 4.2 s after the payment provider's TLS endpoint started rate-limiting our connection pool. A pool-size fix is deployed; latency is back under 600 ms and we are watching the evening peak before closing this."}},
    {"k":"r.0.2","t":"stack","p":{"gap":"s"},"c":[
      {"k":"r.0.2.0","t":"text","p":{"style":"title","text":"Impact"}},
      {"k":"r.0.2.1","t":"text","p":{"style":"callout","tone":"danger","text":"About 18% of checkouts between 14:02 and 15:10 CEST took longer than 4 s; 312 were abandoned."}},
      {"k":"r.0.2.2","t":"text","p":{"style":"callout","tone":"ok","text":"Recovered: p95 is 580 ms since 15:10 CEST."}},
      {"k":"r.0.2.3","t":"text","p":{"style":"footnote","tone":"muted","text":"Reported by synthetic-checks · owner Ben Ortiz"}}
    ]},
    {"k":"r.0.3","t":"stack","p":{"gap":"s"},"c":[
      {"k":"r.0.3.0","t":"text","p":{"style":"title2","text":"Timeline"}},
      {"k":"r.0.3.1:2026-09-21T12:02:00Z","t":"stack","p":{"gap":"none"},"c":[
