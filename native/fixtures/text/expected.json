      ]},
      {"k":"r.0.3.1:2026-09-21T12:40:00Z","t":"stack","p":{"gap":"none"},"c":[
        {"k":"r.0.3.1:2026-09-21T12:40:00Z.0","t":"text","p":{"style":"caption2","tone":"muted","text":"14:40"}},
