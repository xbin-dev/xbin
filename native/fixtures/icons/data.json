      {"title": "People", "icons": ["person", "people", "agent"]},
      {"title": "Status", "icons": ["info", "question", "warning", "error", "eye", "eye-slash"]},
      {"title": "Infrastructure", "icons": ["globe", "cloud", "server", "database", "cpu", "network", "code", "branch"]},
