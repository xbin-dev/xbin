{"v":1,"root":{"k":"r","t":"screen","p":{"title":"Rotate the database password","subtitle":"updated Sep 18, 2026","style":"scroll"},"c":[
  {"k":"r.0","t":"markdown","p":{"tokens":[
      {"t":"heading","depth":1,"c":[{"t":"text","text":"Rotate the database password"}]},
      {"t":"paragraph","c":[{"t":"text","text":"Rotating is "},{"t":"strong","c":[{"t":"text","text":"safe during business hours"}]},{"t":"text","text":": the app holds "},{"t":"em","c":[{"t":"text","text":"two"}]},{"t":"text","text":" valid passwords while the change rolls out. Ask in "},{"t":"codespan","text":"#ops"},{"t":"text","text":" before you start; see "},{"t":"link","href":"https://wiki.acme.dev/security/credentials","c":[{"t":"text","text":"the credentials policy"}]},{"t":"text","text":" for why we rotate every 90 days. "},{"t":"del","c":[{"t":"text","text":"Restart the API by hand"}]},{"t":"text","text":" — no longer needed since v2.12."}]},
      {"t":"heading","depth":2,"c":[{"t":"text","text":"Before you start"}]},
      {"t":"list","ordered":false,"loose":false,"items":[{"c":[{"t":"paragraph","c":[{"t":"text","text":"You need the "},{"t":"codespan","text":"db-admin"},{"t":"text","text":" role on "},{"t":"strong","c":[{"t":"text","text":"acme-prod"}]}]}]},{"c":[{"t":"paragraph","c":[{"t":"text","text":"A terminal with "},{"t":"codespan","text":"bx"},{"t":"text","text":" logged in"}]}]},{"c":[{"t":"paragraph","c":[{"t":"text","text":"About 15 minutes"}]}]}]},
      {"t":"heading","depth":2,"c":[{"t":"text","text":"Steps"}]},
      {"t":"list","ordered":true,"loose":true,"items":[{"c":[{"t":"paragraph","c":[{"t":"text","text":"Create the new password in the vault:"}]},{"t":"code","text":"bx secret new db/app-password --length 32","lang":"sh"}]},{"c":[{"t":"paragraph","c":[{"t":"text","text":"Add it as the "},{"t":"em","c":[{"t":"text","text":"secondary"}]},{"t":"text","text":" password (the database accepts both)."}]}]}],"start":1},
      {"t":"paragraph","c":[{"t":"text","text":"Now roll the API one replica at a time, and go on once every replica is healthy:"}]},
      {"t":"list","ordered":true,"loose":true,"items":[{"c":[{"t":"paragraph","c":[{"t":"text","text":"Promote the new password to primary."}]}]},{"c":[{"t":"paragraph","c":[{"t":"text","text":"Drop the old one:"}]},{"t":"code","text":"ALTER ROLE app PASSWORD NULL;"}]}],"start":3},
      {"t":"blockquote","c":[{"t":"paragraph","c":[{"t":"strong","c":[{"t":"text","text":"Heads up:"}]},{"t":"br"},{"t":"text","text":"the billing worker caches its connection for up to 10 minutes. Wait before dropping the old password."}]}]},
      {"t":"heading","depth":3,"c":[{"t":"text","text":"Checklist"}]},
      {"t":"list","ordered":false,"loose":false,"items":[{"c":[{"t":"paragraph","c":[{"t":"text","text":"Vault entry created"}]}],"task":true,"checked":true},{"c":[{"t":"paragraph","c":[{"t":"text","text":"Secondary password added"}]}],"task":true,"checked":true},{"c":[{"t":"paragraph","c":[{"t":"text","text":"API rolled"}]}],"task":true,"checked":false},{"c":[{"t":"paragraph","c":[{"t":"text","text":"Old password dropped"}]}],"task":true,"checked":false}]},
      {"t":"heading","depth":3,"c":[{"t":"text","text":"Who is affected"}]},
      {"t":"table","align":["left","center","right",null],"header":[[{"t":"text","text":"Service"}],[{"t":"text","text":"Connections"}],[{"t":"text","text":"Downtime"}],[{"t":"text","text":"Owner"}]],"rows":[[[{"t":"text","text":"api"}],[{"t":"text","text":"32"}],[{"t":"text","text":"none"}],[{"t":"text","text":"Ben"}]],[[{"t":"text","text":"billing-worker"}],[{"t":"text","text":"4"}],[{"t":"text","text":"up to 10 min"}],[{"t":"text","text":"Chloé"}]],[[{"t":"text","text":"reports"}],[{"t":"text","text":"2"}],[{"t":"text","text":"none"}],[{"t":"text","text":"Ana"}]]]},
      {"t":"hr"},
      {"t":"heading","depth":4,"c":[{"t":"text","text":"Rolling back"}]},
      {"t":"paragraph","c":[{"t":"text","text":"If the API fails to connect, re-run step 2 with the "},{"t":"em","c":[{"t":"text","text":"old"}]},{"t":"text","text":" password."}]},
