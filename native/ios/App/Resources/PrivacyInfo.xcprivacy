<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The app's privacy manifest (native/AGENTS.md → "App Store": what we tell
  Apple and why; checked by native/tools/store-check.py).

  No tracking, no analytics, no advertising, and no code that collects data
  for the developer. The app talks to the workspaces its user adds — servers
  they run — and, for its remote kill switch, fetches
  https://xbin.dev/app/ios.json (no identifiers sent). Neither is data the
  developer collects.

  App tunnels (D204, native/spec/tunnel.md): the app links IrohLib (n0's
  iroh-ffi, open source) to reach a workspace that turned tunnels on. It
  connects only out, to that workspace, through the relay the workspace
  names: n0's public relays or one the workspace's operator runs. The relay
  sees the device's IP address and connection metadata, never content (Noise
  inside QUIC). That is the user's own connection to their own server, not
  data the developer collects, so nothing is declared below for it
  (website/privacy.html says who sees what).

  Push is the exception: once the user allows notifications for a
  workspace, the app registers its APNs device token with the push relay
  the xbin project runs (XbinPushRelay in Support/App-Info.plist:
  https://notif-fwd.xbin.dev; native/spec/push.md). So
  NSPrivacyCollectedDataTypeDeviceID is declared below — not linked, not
  tracking, App Functionality — and App Store Connect's App Privacy must
  say the same (store-check.py checks this file against the plist).
--><plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- The APNs device token the push relay keeps to deliver
		     notifications; it knows no user, name or workspace URL. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- The app's own settings, caches and scene state (AppSettings,
		     TerminalPrefs, RemoteConfig, LiveActivities, @SceneStorage). -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<!-- SwiftTerm's kitty graphics protocol stat()s and fstat()s image
		     files in the app's temporary directory and shared memory to
		     check their type and size (KittyGraphics.swift). -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<!-- IrohLib (app tunnels): `nm -u` on iroh-ffi 1.2.0 (2026-10-27)
		     finds fstat (Rust's std sizing the files it reads), covered by
		     the file-timestamp entry above, and nothing of the boot-time
		     (mach_absolute_time, systemUptime), disk-space (statfs family)
		     or user-defaults APIs. Re-measure with every IrohLib bump; list
		     what it needs here AND in store-check.py's IROHLIB_APIS. -->
	</array>
</dict>
</plist>
