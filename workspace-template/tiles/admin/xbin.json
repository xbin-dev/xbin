{
  // Admin console: full owner-view into the running workspace. Needs the
  // workspace-administration capability — a grant on the reserved target
  // "xbin" at role "admin". The template pre-approves it; revoke with
  //   bx grant --revoke tiles/admin xbin:admin
  // and every panel here 403s (the request reappears in the grants panel).
  //
  // xbin:admin is heavy: it reads every vault secret and rewrites the
  // grant table. Grant it only to tiles you trust as you trust yourself.
  "uses": [
    { "target": "xbin", "role": "admin" }
  ]
}
