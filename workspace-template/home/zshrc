# ~/.zshrc — seeded by xbin init.
#
# This HOME is <workspace>/home: it persists across container upgrades and
# is shared by every xbin terminal in this workspace. It is NOT your host
# home — copy in whatever config you like (it's gitignored by default).

autoload -Uz compinit && compinit -d "$HOME/.zcompdump"
autoload -Uz colors && colors

setopt prompt_subst autocd interactivecomments
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt inc_append_history hist_ignore_dups share_history

# Component-aware prompt: XBIN_COMPONENT is set per terminal session.
PROMPT='%F{blue}${XBIN_COMPONENT:-workspace}%f %F{244}%2~%f %F{green}❯%f '

alias ls='ls --color=auto'
alias ll='ls -la'
alias grep='grep --color=auto'
export EDITOR="${EDITOR:-vim}"

# bx completion-ish helpers
alias logs='bx logs -f'
