bin/
devws*/
# hack/demo/up.sh's workspaces and their snapshots (the demo film set)
/.demo/
.rootfs/
go.work.sum
*.log
*_scrot.png

# Build output and release bundles. The embedded trees (web/, docs/,
# workspace-template/, builtin-tiles/, builtin-templates/) ship inside
# xbind byte-for-byte, so a stray `go build` binary in a tile's backend dir
# would be embedded too — assets_test.go refuses that; this keeps it out of
# `git add -A` as well.
dist/
/bx
# Packed helper sets (make helpers-publish stages them outside the tree;
# they live in the helpers bucket, never in git — hack/check-large-files.sh).
*.tar.zst
website/dist/
# the prebuilt helpers served from the site (hack/helpers-static.sh) — binaries, never tracked
website/static-helpers/
builtin-tiles/*/backend/backend
builtin-templates/*/_backend/_backend
examples/*/backend/backend

# Local Claude/agent backups — NEVER publish (contain credentials, cache, debug)
bak*.tar
dotclaude-bak*/
.claude-bak*/
# Secrets & local env — defense-in-depth (none of these are tracked today)
.env
.env.*
*.pem
*.key
.credentials.json
*.credentials.json
# S3 credentials for publishing prebuilt helpers (hack/check-s3.sh,
# make helpers-publish); the template s3secret.env.example is tracked
s3secret.env
*.secret.env
/backend

# hack/dev-setup.sh: this machine's test environment
.dev.mk
