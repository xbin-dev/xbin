# Copy to .env (gitignored) next to compose.yml, then `docker compose up -d`.
# Generate a strong value:  openssl rand -base64 24

# Required — encrypts the vault at rest; xbind refuses to start without it.
# Losing this loses the encrypted secrets. Keep it out of git.
XBIN_VAULT_PASSPHRASE=

# Optional — where the workspace directory lives on the host (default ./workspace).
# XBIN_WORKSPACE=./workspace
