{
  // A net-provider tile (plans/interfaces.md): a plain L3 router. Components whose
  // `net` interface is bound to this tile have their egress spliced through here;
  // this tile forwards it to its own egress (bound below to the internet). Extend
  // the backend with nftables rules for a firewall, a wg interface for a VPN, etc.
  "runtime": "go",
  "interfaces": { "net": { "kind": "net" } },  // this router's own egress — owner binds it (e.g. bx bind <this> net=internet)
  "provides": { "net": { "kind": "net" } }     // offers a net interface to others
}
