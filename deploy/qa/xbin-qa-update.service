[Unit]
Description=xbin QA auto-updater (poll releases, install, restart)
After=network-online.target xbin.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/xbin-qa/xbin-qa-update.sh
# A oneshot has no login environment; the installer (set -u) reads $HOME &
# co. — give it root's, as `sudo bash setup.sh` did on first install.
Environment=HOME=/root USER=root LOGNAME=root
# The updater reinstalls xbind and restarts it; give it room.
TimeoutStartSec=600
