# S3-compatible storage for the prebuilt helper binaries (gocryptfs,
# fuse-overlayfs, the VM assets): `make helpers` downloads them from the
# PUBLIC read URL; `make helpers-publish` (a maintainer, never CI) uploads
# them with the credentials below. Check a filled-in copy with
# hack/check-s3.sh.
#
# Copy to s3secret.env (gitignored: never commit the real one) and fill in.
# Plain KEY=value lines, no quotes needed, no spaces around '='.

# The bucket objects go to.
XBIN_HELPERS_S3_BUCKET=

# S3 API endpoint. Empty for AWS itself; for S3-compatible services, e.g.
#   Cloudflare R2:  https://<account-id>.r2.cloudflarestorage.com
#   Backblaze B2:   https://s3.<region>.backblazeb2.com
#   MinIO:          https://minio.example.com
XBIN_HELPERS_S3_ENDPOINT=

# Signing region: the bucket's region for AWS/B2, "auto" for R2.
XBIN_HELPERS_S3_REGION=us-east-1

# Optional key prefix inside the bucket, with a trailing slash, e.g. helpers/
XBIN_HELPERS_S3_PREFIX=

# The public, unauthenticated read URL of the bucket's root: object <key> is
# served at $XBIN_HELPERS_URL/<key> (a custom domain on R2, the bucket's
# public URL on S3/B2, …). Must be readable without credentials.
XBIN_HELPERS_URL=

# Write credentials, for the publisher only (put + delete on the bucket or
# the prefix is enough). CI and users never need these.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
