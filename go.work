// Dev workspace for the xbin repo itself: lets the examples build (and
// gopls resolve the sdk) without publishing the sdk module. Workspaces
// created by `xbind init` get their own generated go.work — this one is
// only for hacking on xbin.
go 1.26.3

use (
	.
	./examples/calendar
	./examples/counter-go
	./examples/email
	./sdk
)
